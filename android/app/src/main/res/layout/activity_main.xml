<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <TextureView
        android:id="@+id/uvc"
        android:layout_width="2dp"
        android:layout_height="2dp"
        android:importantForAccessibility="no" />

    <online.seuprojeto.filtrofanta.DripBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- TELA CAPTURA (#capture) -->
    <LinearLayout
        android:id="@+id/screenCapture"
        style="@style/BoothScreen"
        android:paddingTop="6dp"
        android:paddingBottom="0dp">

        <ImageView style="@style/BoothTopLogo" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/screen_gutter"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="@dimen/screen_gutter"
            android:layout_weight="1">

            <online.seuprojeto.filtrofanta.PolaroidFrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <online.seuprojeto.filtrofanta.AspectRatioFrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#111111">

                    <ImageView
                        android:id="@+id/preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Preview"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:id="@+id/loader"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ProgressBar
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:indeterminateTint="@color/fanta_orange" />

                        <TextView
                            android:id="@+id/statusText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/fanta_sans_regular"
                            android:gravity="center"
                            android:text="Preparando câmera…"
                            android:textColor="#D9FFFFFF"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/countdown"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/countdownNum"
                            android:layout_width="@dimen/countdown_bubble_min"
                            android:layout_height="@dimen/countdown_bubble_min"
                            android:layout_gravity="center"
                            android:background="@drawable/countdown_bubble"
                            android:fontFamily="@font/fanta_pop_condensed"
                            android:gravity="center"
                            android:text="3"
                            android:textColor="@color/ink"
                            android:textSize="42sp"
                            android:textStyle="bold" />
                    </FrameLayout>
                </online.seuprojeto.filtrofanta.AspectRatioFrameLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/polaroid_footer_min_height"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp">

                    <Button
                        android:id="@+id/btnSnap"
                        style="@style/BoothButtonFanta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="28dp"
                        android:layout_marginEnd="28dp"
                        android:text="TIRAR FOTO" />
                </FrameLayout>
            </online.seuprojeto.filtrofanta.PolaroidFrameLayout>
        </FrameLayout>

        <include
            layout="@layout/include_how_panel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp" />
    </LinearLayout>

    <!-- TELA RESULTADO (#result) -->
    <LinearLayout
        android:id="@+id/screenResult"
        style="@style/BoothScreen"
        android:paddingTop="6dp"
        android:visibility="gone">

        <ImageView style="@style/BoothTopLogo" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/screen_gutter"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="@dimen/screen_gutter"
            android:layout_weight="1">

            <online.seuprojeto.filtrofanta.PolaroidFrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <online.seuprojeto.filtrofanta.AspectRatioFrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#111111">

                    <ImageView
                        android:id="@+id/shotImg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Sua foto"
                        android:scaleType="centerCrop" />
                </online.seuprojeto.filtrofanta.AspectRatioFrameLayout>

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="-32dp"
                    android:layout_marginBottom="-48dp"
                    android:contentDescription="@null"
                    android:paddingTop="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_fanta" />
            </online.seuprojeto.filtrofanta.PolaroidFrameLayout>
        </FrameLayout>

        <Button
            android:id="@+id/btnShare"
            style="@style/BoothButtonFanta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/share_margin_top"
            android:layout_marginBottom="24dp"
            android:enabled="false"
            android:minWidth="280dp"
            android:text="COMPARTILHAR" />
    </LinearLayout>

    <!-- TELA PRONTO (#ready) -->
    <LinearLayout
        android:id="@+id/screenReady"
        style="@style/BoothScreen"
        android:paddingStart="19dp"
        android:paddingEnd="19dp"
        android:paddingBottom="32dp"
        android:visibility="gone">

        <ImageView style="@style/BoothTopLogo" />

        <TextView
            style="@style/BoothReadyHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="SUA FOTO ESTÁ PRONTA!" />

        <TextView
            style="@style/BoothReadyLead"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxWidth="320dp"
            android:text="TOQUE EM COMPARTILHAR PARA ENVIAR PELA GALERIA OU REDES." />

        <FrameLayout
            android:layout_width="@dimen/qr_box_max"
            android:layout_height="@dimen/qr_box_max"
            android:layout_marginTop="16dp"
            android:background="#FFFFFF"
            android:padding="10dp">

            <ImageView
                android:id="@+id/readyThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Miniatura da foto"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <Button
            android:id="@+id/btnShareReady"
            style="@style/BoothButtonFanta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minWidth="280dp"
            android:text="COMPARTILHAR" />

        <Button
            android:id="@+id/btnAgain"
            style="@style/BoothButtonAgain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="RECOMEÇAR" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fanta_orange"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/top_logo_splash"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:src="@drawable/logo_fanta" />

            <TextView
                android:id="@+id/splashStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/fanta_sans_regular"
                android:gravity="center"
                android:text="Carregando IA local…"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
