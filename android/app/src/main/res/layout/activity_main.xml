<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <TextureView
        android:id="@+id/uvc"
        android:layout_width="2dp"
        android:layout_height="2dp"
        android:importantForAccessibility="no" />

    <!-- Fundo “drip” igual ao site -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_orange" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_drip_overlay" />
    </FrameLayout>

    <!-- TELA 1: CAPTURA -->
    <LinearLayout
        android:id="@+id/screenCapture"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="190dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:src="@drawable/logo_fanta" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="16dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/polaroid_card"
                android:elevation="10dp"
                android:orientation="vertical"
                android:padding="14dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="#111111">

                    <ImageView
                        android:id="@+id/preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Preview"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:id="@+id/loader"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ProgressBar
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:indeterminateTint="@color/fanta_orange" />

                        <TextView
                            android:id="@+id/statusText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/fanta_sans_regular"
                            android:gravity="center"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="Preparando câmera…"
                            android:textColor="#D9FFFFFF"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/countdown"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/countdownNum"
                            android:layout_width="88dp"
                            android:layout_height="88dp"
                            android:layout_gravity="center"
                            android:background="@drawable/countdown_bubble"
                            android:fontFamily="@font/fanta_pop_condensed"
                            android:gravity="center"
                            android:text="3"
                            android:textColor="@color/ink"
                            android:textSize="42sp"
                            android:textStyle="bold" />
                    </FrameLayout>
                </FrameLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="88dp"
                    android:paddingTop="4dp">

                    <Button
                        android:id="@+id/btnSnap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_btn_fanta"
                        android:fontFamily="@font/fanta_pop_condensed"
                        android:minWidth="220dp"
                        android:paddingStart="28dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="28dp"
                        android:paddingBottom="20dp"
                        android:text="TIRAR FOTO"
                        android:textAllCaps="true"
                        android:textColor="@color/ink"
                        android:textSize="18sp" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/how_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.9"
                android:fontFamily="@font/fanta_pop_condensed"
                android:text="COMO\nFUNCIONA?"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.4"
                android:fontFamily="@font/fanta_sans_bold"
                android:lineSpacingExtra="2dp"
                android:text="1. POSICIONE-SE NO CENTRO DA TELA\n2. TOQUE EM TIRAR FOTO\n3. SORRIA E PREPARE-SE"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- TELA 2: RESULTADO -->
    <LinearLayout
        android:id="@+id/screenResult"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="190dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:src="@drawable/logo_fanta" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="24dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/polaroid_card"
                android:elevation="10dp"
                android:orientation="vertical"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/shotImg"
                    android:layout_width="match_parent"
                    android:layout_height="360dp"
                    android:background="#111111"
                    android:contentDescription="Sua foto"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="-8dp"
                    android:contentDescription="@null"
                    android:paddingTop="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_fanta" />
            </LinearLayout>
        </FrameLayout>

        <Button
            android:id="@+id/btnShare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_btn_fanta"
            android:enabled="false"
            android:fontFamily="@font/fanta_pop_condensed"
            android:minWidth="260dp"
            android:paddingStart="28dp"
            android:paddingTop="12dp"
            android:paddingEnd="28dp"
            android:paddingBottom="20dp"
            android:text="COMPARTILHAR"
            android:textAllCaps="true"
            android:textColor="@color/ink"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- TELA 3: PRONTO (sem VPS: preview no lugar do QR) -->
    <LinearLayout
        android:id="@+id/screenReady"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="190dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:src="@drawable/logo_fanta" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/fanta_pop_condensed"
            android:gravity="center"
            android:text="SUA FOTO ESTÁ PRONTA!"
            android:textColor="@color/fanta_orange"
            android:textSize="28sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/fanta_sans_bold"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:text="TOQUE EM COMPARTILHAR PARA ENVIAR PELA GALERIA OU REDES."
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <FrameLayout
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_marginTop="16dp"
            android:background="#FFFFFF"
            android:padding="10dp">

            <ImageView
                android:id="@+id/readyThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Miniatura da foto"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <Button
            android:id="@+id/btnShareReady"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_btn_fanta"
            android:fontFamily="@font/fanta_pop_condensed"
            android:minWidth="260dp"
            android:paddingStart="28dp"
            android:paddingTop="12dp"
            android:paddingEnd="28dp"
            android:paddingBottom="20dp"
            android:text="COMPARTILHAR"
            android:textAllCaps="true"
            android:textColor="@color/ink"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnAgain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_white_pill"
            android:fontFamily="@font/fanta_pop_condensed"
            android:paddingStart="36dp"
            android:paddingTop="14dp"
            android:paddingEnd="36dp"
            android:paddingBottom="14dp"
            android:text="RECOMEÇAR"
            android:textAllCaps="true"
            android:textColor="@color/ink"
            android:textSize="18sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fanta_orange"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:src="@drawable/logo_fanta" />

            <TextView
                android:id="@+id/splashStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/fanta_sans_regular"
                android:gravity="center"
                android:text="Carregando IA local…"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
