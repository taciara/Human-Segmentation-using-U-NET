<?xml version="1.0" encoding="utf-8"?>
<online.seuprojeto.filtrofanta.HowPanelLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:background="@drawable/how_panel"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.9"
        android:fontFamily="@font/fanta_pop_condensed"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:singleLine="true"
        android:text="COMO FUNCIONA?"
        android:textColor="#FFFFFF"
        android:textSize="25sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1.4"
        android:orientation="vertical"
        android:paddingStart="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fanta_sans_bold"
            android:includeFontPadding="false"
            android:letterSpacing="0.01"
            android:text="1. POSICIONE-SE NO CENTRO DA TELA"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/fanta_sans_bold"
            android:includeFontPadding="false"
            android:letterSpacing="0.01"
            android:text="2. TOQUE EM TIRAR FOTO"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/fanta_sans_bold"
            android:includeFontPadding="false"
            android:letterSpacing="0.01"
            android:text="3. SORRIA E PREPARE-SE"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>
</online.seuprojeto.filtrofanta.HowPanelLayout>
